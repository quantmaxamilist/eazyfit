---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import EnquiryBand from '../components/site/EnquiryBand.astro';
import Img from '../components/site/Img.astro';
import Icon from '../components/site/Icon.astro';
import { titles, services, leka, company, local } from '../data/site';
---
<Base title={titles.services} description={local.descriptions.services} crumb={services.title} schema={[...services.items, { name: 'Leka Roofs', text: leka.paras[0] }].map((s) => ({ '@type': 'Service', name: s.name, serviceType: s.name, description: s.text }))}>
  <PageHero bg={{ kind: 'video', name: 'window', poster: '/images/bg/window-poster.jpg', loop: false }} crumb={services.title} title={services.title} where={local.h1.services} lead={services.intro[0]} image="services/porch-door" alt="Enclosed porch with a white uPVC door" />

  <section class="si section light">
    <div class="container si__in">
      <p class="statement" data-reveal="fade">{services.intro[1]}</p>
      <div class="prose" data-reveal="fade" data-delay="0.08"><p>{services.intro[2]}</p></div>
    </div>
  </section>

  <section class="sv light" aria-label="Services">
    <div class="container">
      <ol class="sv__list" role="list">
        {services.items.map((s, i) => (
          <li class="sv__row" id={s.slug}>
            <figure class="sv__frame" data-reveal="fade"><span class="ph-img"><Img image={s.image} alt={s.alt} sizes="(max-width: 899px) 90vw, 40vw" /></span></figure>
            <div class="sv__copy" data-reveal="fade" data-delay="0.06">
              <p class="label">0{i + 1} / 0{services.items.length + 1}</p>
              <h2 class="display h-2 sv__h">{s.name}</h2>
              <p class="lead sv__txt">{s.text}</p>
              <div class="btn-row">
                <a class="btn" href={`/contact-us?service=${s.slug}`}>Contact Us <Icon name="arrow" /></a>
                <a class="btn btn--ghost" href={company.phoneHref}><Icon name="phone" />{company.phone}</a>
              </div>
            </div>
          </li>
        ))}
        <li class="sv__row sv__row--leka" id="leka-roofs">
          <figure class="sv__frame" data-reveal="fade"><span class="ph-img"><Img image={leka.images[0].image} alt={leka.images[0].alt} sizes="(max-width: 899px) 90vw, 40vw" /></span></figure>
          <div class="sv__copy" data-reveal="fade" data-delay="0.06">
            <p class="label">04 / 04</p>
            <h2 class="display h-2 sv__h">Leka Roofs</h2>
            <p class="lead sv__txt">{leka.paras[0]}</p>
            <div class="btn-row">
              <a class="btn" href="/leka-roofs">Leka Roofs <Icon name="arrow" /></a>
              <a class="btn btn--ghost" href="/contact-us?service=leka-roofs">Contact Us</a>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <EnquiryBand />
</Base>
<style>
  .si__in { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--sp-8); align-items: start; }
  .si .statement { color: var(--c-ink); }
  .sv { padding-bottom: var(--section-y); }
  .sv__list { display: grid; gap: clamp(3rem, 2rem + 4vw, 7rem); }
  .sv__row { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--sp-8); align-items: center; scroll-margin-top: calc(var(--header-h) + 24px); }
  .sv__row:nth-child(even) .sv__frame { order: 2; }
  .sv__frame { padding: var(--frame-bar); background: #fff; border-radius: 6px; box-shadow: 0 1px 0 var(--c-line), 0 30px 60px -30px rgba(71, 5, 87, 0.45); max-width: 480px; width: 100%; }
  .sv__row:nth-child(even) .sv__frame { justify-self: end; }
  .sv__frame .ph-img { display: block; aspect-ratio: 1; border-radius: 2px; }
  .sv__h { margin-top: var(--sp-4); color: var(--c-purple); }
  .sv__txt { margin-top: var(--sp-5); color: var(--c-ink-2); max-width: 52ch; }
  .sv .btn-row { margin-top: var(--sp-6); }
  @media (max-width: 899px) {
    .si__in, .sv__row { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); }
    .sv__row:nth-child(even) .sv__frame { order: 0; justify-self: start; }
  }
</style>
