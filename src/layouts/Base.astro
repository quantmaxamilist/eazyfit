---
import '../styles/tokens.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Dock from '../components/site/Dock.astro';
import { company, home, services as svc, local } from '../data/site';

interface Props { title: string; description: string; image?: string; noindex?: boolean; preloadImage?: string; crumb?: string; schema?: Record<string, unknown>[] }
const { title, description: raw, image = '/images/home/victorian-conservatory.jpg', noindex = false, preloadImage, crumb, schema = [] } = Astro.props;
// Snippets ≤155 chars, cut on a word. Descriptions come from local.descriptions (facts from the old copy).
const description = raw.length <= 155 ? raw : raw.slice(0, 154).replace(/\s+\S*$/, '').replace(/[\s,;:.–-]+$/, '') + '…';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
// Local business data. No street address or opening hours: the old site publishes neither.
const bizId = `${company.url}/#business`;
const places = home.areas.map((a) => (['Sussex', 'Hampshire'].includes(a)
  ? { '@type': 'AdministrativeArea', name: a }
  : { '@type': a === 'The Witterings' ? 'Place' : 'City', name: a, containedInPlace: { '@type': 'AdministrativeArea', name: local.region } }));
const ld: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': bizId,
  name: company.fullName,
  alternateName: [company.name, company.legalName],
  url: company.url,
  telephone: '+447497520140',
  email: company.email,
  logo: new URL('/images/brand/logo.png', Astro.site).href,
  image: new URL(image, Astro.site).href,
  description: home.about[0],
  address: { '@type': 'PostalAddress', addressLocality: 'Bognor Regis', addressRegion: local.region, addressCountry: 'GB' },
  areaServed: places,
  knowsAbout: ['Replacement windows', 'Doors', 'Conservatories', 'LEKA Roof System', 'Solid conservatory roofs', 'Warm roofs'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: svc.title,
    itemListElement: [...svc.items.map((s) => s.name), 'Leka Roofs', 'Commercial'].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
}];
if (crumb) ld.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Welcome', item: `${company.url}/` },
    { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
  ],
});
for (const s of schema) ld.push({ '@context': 'https://schema.org', provider: { '@id': bizId }, areaServed: places, ...s });
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
      try { if (sessionStorage.getItem('ez:pt')) d.classList.add('pt-arrive'); } catch (e) {}
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#1b0a22" />
  <meta name="geo.region" content="GB-WSX" />
  <meta name="geo.placename" content="Bognor Regis" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={company.fullName} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <Dock />
  <slot name="after" />
  <div class="cursor" id="cursor" aria-hidden="true"><div class="cursor__ring"></div><div class="cursor__dot"></div></div>
  <div class="pt" id="pt" aria-hidden="true"><img src="/images/brand/logo.png" width="433" height="421" alt="" /></div>
  <script>import '../scripts/core.js';</script>
</body>
</html>
