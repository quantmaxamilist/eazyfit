---
// Shared header background: video, slow-zoom photo or drifting photo wall, under the brand tint.
// Stock clips are Pexels (free licence): chichester = pexels.com/video/14524802, rooftops = /33497966,
// window = /32078278. Reduced motion and Save-Data get the still poster only.
import { src, size } from '../../data/extra';
import Icon from './Icon.astro';

type Video = { kind: 'video'; name: 'chichester' | 'rooftops' | 'window'; poster: string; loop?: boolean; start?: number; position?: string };
type Photo = { kind: 'photo'; image: string; position?: string };
type Wall = { kind: 'wall'; images: string[] };
interface Props { bg: Video | Photo | Wall; place?: string; strength?: 'home' | 'page' }
const { bg, place, strength = 'page' } = Astro.props;
const wall = bg.kind === 'wall' ? [...bg.images, ...bg.images] : [];
---
<div class={`hb hb--${bg.kind} hb--${strength}`} aria-hidden="true" data-hb>
  {bg.kind === 'video' && (
    <>
      <img class="hb__media hb__poster" src={bg.poster} width="1280" height="720" alt="" decoding="async" style={bg.position ? `object-position:${bg.position}` : undefined} />
      <video class="hb__media hb__video" muted playsinline preload="none" loop={bg.loop !== false} data-hb-video data-name={bg.name} data-start={bg.start ?? 0} style={bg.position ? `object-position:${bg.position}` : undefined}></video>
    </>
  )}
  {bg.kind === 'photo' && (
    <img class="hb__media hb__photo" src={src(bg.image)} width={size(bg.image)[0]} height={size(bg.image)[1]} alt="" decoding="async" style={bg.position ? `object-position:${bg.position}` : undefined} />
  )}
  {bg.kind === 'wall' && (
    <div class="hb__wall">
      <div class="hb__track">
        {wall.map((im) => <img src={src(im)} width="500" height="500" alt="" loading="lazy" decoding="async" />)}
      </div>
    </div>
  )}
  <i class="hb__tint"></i>
</div>
{place && <p class="hb__place" aria-hidden="true"><Icon name="pin" />{place}</p>}

<style>
  .hb { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hb__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8); }
  .hb--home .hb__media { opacity: 0.62; }
  .hb--page .hb__media { opacity: 0.5; }
  .hb__video { opacity: 0 !important; transition: opacity 1.2s var(--ease-out); }
  /* Once the video plays, the poster fades out so the two never show as a double exposure. */
  .hb__poster { transition: opacity 1.2s var(--ease-out); }
  .hb.is-playing .hb__poster { opacity: 0; }
  .hb--home .hb__video.is-on { opacity: 0.62 !important; }
  .hb--page .hb__video.is-on { opacity: 0.5 !important; }
  .hb__photo { animation: hb-zoom 24s ease-in-out infinite alternate; transform-origin: 60% 50%; }
  @keyframes hb-zoom { from { transform: scale(1); } to { transform: scale(1.12); } }
  .hb__wall { position: absolute; inset: -10% -5%; transform: rotate(-6deg); opacity: 0.45; }
  .hb__track { display: grid; grid-auto-flow: column; grid-template-rows: repeat(3, 1fr); grid-auto-columns: clamp(140px, 14vw, 220px); gap: 12px; height: 100%; width: max-content; animation: hb-drift 70s linear infinite; }
  .hb__track img { width: 100%; height: 100%; object-fit: cover; border: 5px solid rgba(255, 255, 255, 0.85); border-radius: 4px; }
  @keyframes hb-drift { to { transform: translate3d(-50%, 0, 0); } }
  .hb.is-paused .hb__photo, .hb.is-paused .hb__track { animation-play-state: paused; }
  .hb__tint { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(27, 10, 34, 0.86) 0%, rgba(27, 10, 34, 0.5) 50%, rgba(27, 10, 34, 0.18) 100%),
    linear-gradient(0deg, rgba(27, 10, 34, 0.8) 0%, transparent 30%), rgba(71, 5, 87, 0.16); }
  .hb--home .hb__tint { background:
    linear-gradient(90deg, rgba(27, 10, 34, 0.82) 0%, rgba(27, 10, 34, 0.42) 45%, rgba(27, 10, 34, 0.08) 100%),
    linear-gradient(0deg, rgba(27, 10, 34, 0.75) 0%, transparent 28%), rgba(71, 5, 87, 0.14); }
  .hb__place { position: absolute; left: var(--gutter); bottom: 1.25rem; z-index: 1; display: inline-flex; align-items: center; gap: 0.4rem; font: 500 0.6875rem/1 var(--ff-mono); letter-spacing: 0.12em; text-transform: uppercase; color: rgba(228, 242, 247, 0.6); }
  .hb__place :global(svg) { width: 13px; height: 13px; }
  @media (max-width: 899px) {
    .hb__tint { background: linear-gradient(180deg, rgba(27, 10, 34, 0.55) 0%, rgba(27, 10, 34, 0.75) 60%, rgba(27, 10, 34, 0.92) 100%), rgba(71, 5, 87, 0.14); }
  }
  @media (prefers-reduced-motion: reduce) { .hb__photo, .hb__track { animation: none; } }
</style>

<script>
  import { reduced } from '../../scripts/core.js';
  const saveData = (navigator as any).connection?.saveData;
  document.querySelectorAll<HTMLElement>('[data-hb]').forEach((hb) => {
    const video = hb.querySelector<HTMLVideoElement>('[data-hb-video]');
    let inView = true;
    if (video && !reduced && !saveData) {
      const small = matchMedia('(max-width: 899px)').matches;
      video.src = `/video/${video.dataset.name}-${small ? 960 : 1600}.mp4`;
      const start = +(video.dataset.start || 0);
      if (start) video.addEventListener('loadedmetadata', () => { video.currentTime = start; }, { once: true });
      video.addEventListener('playing', () => { video.classList.add('is-on'); hb.classList.add('is-playing'); }, { once: true });
    }
    // Play only while on screen; CSS motion (zoom, drift) pauses too.
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      hb.classList.toggle('is-paused', !inView);
      if (!video?.src) return;
      if (inView && !video.ended) video.play().catch(() => {});
      else video.pause();
    }).observe(hb);
  });
</script>
