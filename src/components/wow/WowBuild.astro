---
// Wow A — "The Build": a conservatory assembles itself in 3D, Leka roof last. Plays once at ≥50% on
// screen, pauses off screen, Replay at the end. Poster for reduced motion / no WebGL.
import FitList from './FitList.astro';
import { fitList } from '../../data/extra';
---
<section class="wb section dark" data-wow="build" data-cursor-theme="dark" aria-labelledby="wb-h">
  <div class="container wb__in">
    <header class="wb__head">
      <p class="label">What we fit</p>
      <h2 id="wb-h" class="display h-2">Our Services</h2>
    </header>
    <div class="wb__stage" data-wb-stage>
      <img class="wb__poster" src="/images/wow/build-poster.jpg" width="1508" height="1132" alt="A conservatory built by EazyFit: brick dwarf wall, white windows, French doors and a tiled Leka solid roof" loading="lazy" />
      <canvas class="wb__canvas" aria-hidden="true"></canvas>
      <div class="wb__pins" aria-hidden="true">
        {fitList.map((f) => <a class="wb__pin" href={f.href} data-key={f.key} tabindex="-1"><i></i></a>)}
      </div>
      <button class="wb__replay" type="button" data-wb-replay>Replay</button>
    </div>
    <div class="wb__list" data-wb-list>
      <FitList />
    </div>
  </div>
</section>
<style>
  .wb { overflow: hidden; }
  .wb::before { content: ''; position: absolute; inset: 0; background: radial-gradient(55% 60% at 38% 55%, rgba(123, 90, 144, 0.4), transparent 70%); pointer-events: none; }
  .wb__in { position: relative; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr); grid-template-areas: 'stage head' 'stage list'; column-gap: var(--sp-8); align-items: start; }
  .wb__head { grid-area: head; align-self: end; }
  .wb__head h2 { margin-top: var(--sp-4); color: #fff; }
  .wb__stage { grid-area: stage; position: relative; aspect-ratio: 4 / 3; width: 100%; }
  .wb__canvas, .wb__poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wb__poster { object-fit: contain; }
  :global(.js) .wb__poster { opacity: 0; }
  .wb.is-poster .wb__poster { opacity: 1; }
  .wb.is-poster .wb__canvas { display: none; }
  .wb__list { grid-area: list; margin-top: var(--sp-6); transition: opacity 0.6s var(--ease-out); }
  :global(.js) .wb:not(.is-done) .wb__list { opacity: 0; }
  :global(.js) .wb:not(.is-done) .wb__list a { pointer-events: none; }
  .wb__pins { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.5s var(--ease-out); }
  .wb.is-done .wb__pins { opacity: 1; }
  .wb__pin { position: absolute; left: 0; top: 0; width: 34px; height: 34px; margin: -17px 0 0 -17px; pointer-events: auto; display: grid; place-items: center; }
  .wb__pin i { width: 14px; height: 14px; border-radius: 50%; background: var(--c-glass); box-shadow: 0 0 0 4px rgba(194, 224, 235, 0.25), 0 4px 10px rgba(0, 0, 0, 0.4); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2); }
  .wb__pin.is-on i, .wb__pin:hover i { transform: scale(1.35); box-shadow: 0 0 0 7px rgba(194, 224, 235, 0.35), 0 4px 10px rgba(0, 0, 0, 0.4); background: #fff; }
  .wb__replay { position: absolute; right: 0; bottom: 0; min-height: 40px; padding: 0 1rem; border-radius: 999px; font: 500 0.75rem var(--ff-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-glass-hi); box-shadow: inset 0 0 0 1px var(--c-line-dark); opacity: 0; pointer-events: none; transition: opacity 0.4s, background-color var(--dur-2); }
  .wb.is-done:not(.is-poster) .wb__replay { opacity: 1; pointer-events: auto; }
  .wb__replay:hover { background: rgba(194, 224, 235, 0.12); }
  @media (max-width: 899px) {
    .wb__in { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'stage' 'list'; }
    .wb__stage { margin-top: var(--sp-5); aspect-ratio: 1 / 1; }
    .wb__pin { width: 28px; height: 28px; margin: -14px 0 0 -14px; }
  }
</style>
<script>
  import { reduced } from '../../scripts/core.js';
  const root = document.querySelector<HTMLElement>('[data-wow="build"]');
  if (root) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const stage = root.querySelector('[data-wb-stage]') as HTMLElement;
    const pins = [...root.querySelectorAll<HTMLElement>('.wb__pin')];
    const rows = [...root.querySelectorAll<HTMLElement>('.fit__row')];
    const hasGL = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    const poster = () => root.classList.add('is-poster', 'is-done');
    if (reduced || !hasGL) poster();
    else {
      let scene: any = null;
      let visible = false;
      const setOn = (key: string | null) => {
        rows.forEach((r) => r.classList.toggle('is-on', r.dataset.key === key));
        pins.forEach((p) => p.classList.toggle('is-on', p.dataset.key === key));
        if (root.classList.contains('is-done')) scene?.highlight(key);
      };
      [...rows, ...pins].forEach((el) => {
        el.addEventListener('pointerenter', () => setOn(el.dataset.key!));
        el.addEventListener('pointerleave', () => setOn(null));
        el.addEventListener('focus', () => setOn(el.dataset.key!));
        el.addEventListener('blur', () => setOn(null));
      });
      const load = () => import('../../scripts/wow-build-scene.js').then(({ createScene }) => {
        const mobile = matchMedia('(max-width: 899px)').matches;
        scene = createScene(canvas, {
          mobile,
          onPins: (pos: Record<string, { x: number; y: number }>) => pins.forEach((p) => { const q = pos[p.dataset.key!]; p.style.transform = `translate3d(${q.x}px, ${q.y}px, 0)`; }),
        });
        scene.onDone = () => root.classList.add('is-done');
        const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 1));
        idle(() => { scene.compile(); scene.reset(); });
        new ResizeObserver(() => scene.resize()).observe(stage);
        if (visible) scene.play();
        addEventListener('pagehide', () => scene.dispose(), { once: true });
      }).catch(poster);
      // fetch three.js in idle time well before the section arrives
      const near = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        near.disconnect();
        const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 200));
        idle(load, { timeout: 1500 });
      }, { rootMargin: '900px 0px' });
      near.observe(root);
      // play at ≥50% on screen; pause when it leaves
      new IntersectionObserver((es) => es.forEach((e) => {
        visible = e.isIntersecting;
        if (!scene) return;
        if (visible) scene.play(); else scene.pause();
      }), { threshold: 0.5 }).observe(stage);
      root.querySelector('[data-wb-replay]')?.addEventListener('click', () => {
        root.classList.remove('is-done'); setOn(null); scene?.replay();
      });
    }
  }
</script>
